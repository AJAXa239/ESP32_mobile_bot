<?xml version="1.0"?>
<robot name="car">

  <material name="chassis_color">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>
  <material name="wheel_color">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- ===== Base / Chassis ===== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.20 0.15 0.05"/>
      </geometry>
      <material name="chassis_color"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.20 0.15 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- ===== Wheel macro (manual, no xacro) ===== -->
  <!-- Front Left -->
  <link name="wheel_front_left">
    <visual>
      <origin rpy="1.5707963 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <origin rpy="1.5707963 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="wheel_front_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_left"/>
    <origin xyz="0.06 0.09 -0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Front Right -->
  <link name="wheel_front_right">
    <visual>
      <origin rpy="1.5707963 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <origin rpy="1.5707963 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="wheel_front_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_front_right"/>
    <origin xyz="0.06 -0.09 -0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear Left -->
  <link name="wheel_rear_left">
    <visual>
      <origin rpy="1.5707963 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <origin rpy="1.5707963 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="wheel_rear_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_left"/>
    <origin xyz="-0.06 0.09 -0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear Right -->
  <link name="wheel_rear_right">
    <visual>
      <origin rpy="1.5707963 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
      <material name="wheel_color"/>
    </visual>
    <collision>
      <origin rpy="1.5707963 0 0" xyz="0 0 0"/>
      <geometry>
        <cylinder radius="0.03" length="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="wheel_rear_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_rear_right"/>
    <origin xyz="-0.06 -0.09 -0.01" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
